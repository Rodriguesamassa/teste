-- [[ Função de Servidor Vazio Otimizada (Evita Erro 772) ]]
local function hopLowServer()
    pcall(function()
        notify("Servidor", "Procurando um servidor com vagas livres...")
        
        local placeId = game.PlaceId
        local servers = {}
        local cursor = ""
        
        repeat
            local url = "https://games.roblox.com/v1/games/" .. placeId .. "/servers/Public?sortOrder=Asc&limit=100"
            if cursor ~= "" and cursor ~= nil then
                url = url .. "&cursor=" .. cursor
            end
            
            local success, rawResult = pcall(function()
                return game:HttpGet(url)
            end)
            
            if success and rawResult then
                local decodeSuccess, result = pcall(function()
                    return HttpService:JSONDecode(rawResult)
                end)
                
                if decodeSuccess and result and result.data then
                    for _, server in ipairs(result.data) do
                        if type(server) == "table" and server.id and server.playing and server.maxPlayers then
                            if server.id ~= game.JobId and server.playing <= (server.maxPlayers - 2) then
                                table.insert(servers, server)
                            end
                        end
                    end
                    cursor = result.nextPageCursor
                else
                    break
                end
            else
                break
            end
        until cursor == nil or cursor == "" or #servers >= 100

        table.sort(servers, function(a, b)
            return a.playing < b.playing
        end)

        if #servers > 0 then
            local teleportsTried = 0
            for _, targetServer in ipairs(servers) do
                teleportsTried += 1
                if teleportsTried > 3 then break end
                
                notify("Servidor", "Entrando no servidor (Jogadores: " .. targetServer.playing .. ")...")
                local tpSuccess = pcall(function()
                    TeleportService:TeleportToPlaceInstance(placeId, targetServer.id, LocalPlayer)
                end)
                
                if tpSuccess then
                    task.wait(2)
                end
            end
        else
            notify("Servidor", "Nenhum servidor ideal encontrado, tentando teleporte aleatório...")
            TeleportService:Teleport(placeId, LocalPlayer)
        end
    end)
end

-- [[ Armazenamento de Valores Originais para Reset (Hitbox e Cabeça) ]]
local originalPlayerSizes = {}

local function storeOriginals(player)
    if player and player.Character then
        local hrp = player.Character:FindFirstChild("HumanoidRootPart")
        local head = player.Character:FindFirstChild("Head")
        if not originalPlayerSizes[player] then
            originalPlayerSizes[player] = {}
        end
        if hrp and not originalPlayerSizes[player].HrpSize then
            originalPlayerSizes[player].HrpSize = hrp.Size
            originalPlayerSizes[player].HrpTrans = hrp.Transparency
        end
        if head and not originalPlayerSizes[player].HeadSize then
            originalPlayerSizes[player].HeadSize = head.Size
            originalPlayerSizes[player].HeadTrans = head.Transparency
        end
    end
end

Players.PlayerRemoving:Connect(function(player)
    originalPlayerSizes[player] = nil
end)

