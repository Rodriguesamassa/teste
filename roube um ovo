    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.Name == "SmartPromptPart" and obj:IsA("BasePart") then
            local d = (obj.Position - pos).Magnitude
            if d < closestDist then
                closestDist = d
                closest = obj
            end
        end
    end
    return closest
end

