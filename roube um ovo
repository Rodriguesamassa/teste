-- [[ Lógica do Anti-Lag ]]
local oldLightingProps = {}
local function applyAntiLag(state)
    if state then
        oldLightingProps.GlobalShadows = Lighting.GlobalShadows
        oldLightingProps.FogEnd = Lighting.FogEnd
        Lighting.GlobalShadows = false
        Lighting.FogEnd = 999999
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") then
                obj.Material = Enum.Material.SmoothPlastic
                obj.Reflectance = 0
            elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") then
                obj.Enabled = false
            end
        end
    else
        if oldLightingProps.GlobalShadows ~= nil then
            Lighting.GlobalShadows = oldLightingProps.GlobalShadows
        end
        if oldLightingProps.FogEnd ~= nil then
            Lighting.FogEnd = oldLightingProps.FogEnd
        end
    end
end

-- [[ Lógica Completa do Auto Farm (Sincronizada, Corrigida e com suporte ao Titan Temple) ]]
local activeTween = nil
local RETURN = Vector3.new(547, 71, -345)
local RAY_DIST = 2000
local RAY_START = 1000
local ws = 0
local wsd = 0
local curHuman = nil
local wsLoop = nil
local wsChar = nil
local farmBtnRef = nil

local function updateFarmButtonUI()
    if not farmBtnRef then return end
    if EggScriptConfig.AutoFarm.Active then
        farmBtnRef.BackgroundColor3 = Color3.fromRGB(60, 200, 100)
        farmBtnRef.Text = "ON"
    else
        farmBtnRef.BackgroundColor3 = Color3.fromRGB(60, 60, 75)
        farmBtnRef.Text = "OFF"
    end
end

local function cancelTween()
    if activeTween then
        activeTween:Cancel()
        activeTween = nil
    end
end

local function stopMove()
    if curHuman then
        local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if hrp then curHuman:MoveTo(hrp.Position) end
    end
end

local function setupWS()
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    if ws == 0 then
        ws = hum.WalkSpeed
        wsd = ws + 10
    end
    if wsLoop then wsLoop:Disconnect() wsLoop = nil end
    if wsChar then wsChar:Disconnect() wsChar = nil end
    
    local function onChange()
        if EggScriptConfig.AutoFarm.Active and hum and hum.Parent then hum.WalkSpeed = wsd
        elseif not EggScriptConfig.AutoFarm.Active and hum and hum.Parent then hum.WalkSpeed = ws end
    end
    
    onChange()
    wsLoop = hum:GetPropertyChangedSignal("WalkSpeed"):Connect(onChange)
    wsChar = LocalPlayer.CharacterAdded:Connect(function(nChar)
        local nh = nChar:WaitForChild("Humanoid")
        if nh then
            hum = nh
            if ws == 0 then
                ws = hum.WalkSpeed
                wsd = ws + 10
            end
            onChange()
            if wsLoop then wsLoop:Disconnect() end
            wsLoop = hum:GetPropertyChangedSignal("WalkSpeed"):Connect(onChange)
        end
    end)
end

local function toggleAutoFarmState()
    EggScriptConfig.AutoFarm.Active = not EggScriptConfig.AutoFarm.Active
    if not EggScriptConfig.AutoFarm.Active then
        cancelTween()
        stopMove()
        if wsLoop then wsLoop:Disconnect() wsLoop = nil end
        if wsChar then wsChar:Disconnect() wsChar = nil end
        local char = LocalPlayer.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then hum.WalkSpeed = ws end
        end
    else
        setupWS()
    end
    updateFarmButtonUI()
end

UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.KeyCode == Enum.KeyCode.F then toggleAutoFarmState() end
