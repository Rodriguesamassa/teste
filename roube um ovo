-- Seletor Atualizado com suporte ao Titan Temple
local function getBestEgg()
    local pSpd = getPlayerSpd()
    local bestReq = -math.huge
    local bestEggs = {}
    
    local foldersToCheck = {
        workspace:FindFirstChild("AreaEggSlotsClient"),
        workspace:FindFirstChild("Eggs"),
        workspace:FindFirstChild("__OBJECTS") and workspace.__OBJECTS:FindFirstChild("Eggs")
    }
    
    for _, folder in ipairs(foldersToCheck) do
        if folder then
            for _, egg in ipairs(folder:GetDescendants()) do
                if egg:IsA("Model") or egg:IsA("BasePart") then
                    local ePos = getPos(egg)
                    if ePos then
                        local area = getAreaAt(ePos)
                        local areaName = area and area.Name or ""
                        local req = getAreaReq(area) or 0
                        
                        -- Se o usuário selecionou uma área específica no menu
                        local selected = EggScriptConfig.AutoFarm.SelectedArea
                        local matchArea = (selected == "Automático (Melhor Área)" or areaName == selected)
                        
                        if pSpd >= req and matchArea then
                            if req > bestReq then
                                bestReq = req
                                table.clear(bestEggs)
                                table.insert(bestEggs, egg)
                            elseif req == bestReq then
                                table.insert(bestEggs, egg)
                            end
                        end
                    end
                end
            end
        end
    end
    
    -- Varredura específica para o Titan Temple (caso utilize a estrutura exata de Nests / EggSpotBottom)
    local guardAreas = getGuardAreas()
    if guardAreas then
        local titanTemple = guardAreas:FindFirstChild("Titan Temple")
        if titanTemple then
            local req = getAreaReq(titanTemple) or 0
            local selected = EggScriptConfig.AutoFarm.SelectedArea
            local matchArea = (selected == "Automático (Melhor Área)" or selected == "Titan Temple")
            
            if pSpd >= req and matchArea then
                local nests = titanTemple:FindFirstChild("Nests")
                if nests then
                    for _, nestIndex in ipairs({2, 3, 4}) do
                        local nest = nests:GetChildren()[nestIndex]
                        if nest then
                            local eggSpot = nest:FindFirstChild("EggSpotBottom")
                            if eggSpot then
                                if req > bestReq then
                                    bestReq = req
                                    table.clear(bestEggs)
                                    table.insert(bestEggs, eggSpot)
                                elseif req == bestReq then
                                    table.insert(bestEggs, eggSpot)
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    
    if #bestEggs == 0 then
        if EggScriptConfig.AutoFarm.SelectedArea ~= "Automático (Melhor Área)" then
            EggScriptConfig.AutoFarm.SelectedArea = "Automático (Melhor Área)"
            notify("Auto Farm", "Área selecionada indisponível. Voltando para modo Automático.")
            return getBestEgg()
        end
        return nil
    end
    
    local biggest = nil
    local biggestSize = -math.huge
    for _, egg in ipairs(bestEggs) do
        local s = getEggSize(egg)
        if s > biggestSize then
            biggestSize = s
            biggest = egg
        end
    end
    return biggest
end

